{
  "name": "ito-core",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ito": "./bin/ito.ts"
  },
  "imports": {
    "#protocol/*": "./protocol/*",
    "#sdk/*": "./capabilities/sdk/*",
    "#reports/*": "./capabilities/reports/*",
    "#*": "./src/*"
  },
  "scripts": {
    "check:spec": "redocly lint protocol/openapi.yaml",
    "check:transcripts": "node protocol/tools/check.ts",
    "generate": "node protocol/tools/scenarios.ts && npm run generate:types",
    "generate:types": "openapi-typescript protocol/openapi.yaml --output protocol/types.ts --root-types --root-types-no-schema-prefix && prettier --write protocol/types.ts",
    "generate:codex": "node src/engine/codex/generate-bindings.ts && prettier --log-level warn --write src/engine/codex/bindings",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "serve": "node bin/ito.ts serve"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.4",
    "@huggingface/transformers": "4.3.1",
    "@openai/codex": "0.164.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.71.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-unicorn": "79.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
