{
  "name": "ito-core",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ito": "./bin/ito.ts"
  },
  "imports": {
    "#protocol/*": "./protocol/*",
    "#sdk/*": "./capabilities/sdk/*",
    "#reports/*": "./capabilities/reports/*",
    "#browser/*": "./capabilities/browser/*",
    "#*": "./src/*"
  },
  "scripts": {
    "check:spec": "redocly lint protocol/openapi.yaml",
    "check:transcripts": "node protocol/tools/check.ts",
    "generate": "node protocol/tools/scenarios.ts && npm run generate:types",
    "generate:types": "openapi-typescript protocol/openapi.yaml --output protocol/types.ts --root-types --root-types-no-schema-prefix && prettier --write protocol/types.ts",
    "generate:codex": "node src/engine/codex/generate-bindings.ts && prettier --log-level warn --write src/engine/codex/bindings",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "serve": "node bin/ito.ts serve"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.7",
    "@huggingface/transformers": "4.3.2",
    "@napi-rs/canvas": "1.2.1",
    "@openai/codex": "0.171.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "domhandler": "6.0.1",
    "fastify": "5.12.8",
    "htmlparser2": "12.0.0",
    "ical.js": "2.2.1",
    "imapflow": "2.12.2",
    "mailparser": "3.15.0",
    "micromark": "4.0.3",
    "nodemailer": "10.6.1",
    "pdfjs-dist": "6.5.438",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "tsdav": "2.5.1",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.83.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-unicorn": "80.0.0",
    "hoodiecrow-imap": "3.3.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1",
    "ws": "8.23.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "allowScripts": {
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
