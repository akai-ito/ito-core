#!/bin/sh
# Git runs this as the commit-msg hook, and CI runs the same file on every new commit and pull
# request, so a message is held to one standard wherever it is written.

set -eu

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
tools='claude|anthropic|openai|codex|copilot|chatgpt|gemini|cursor|devin|aider|windsurf'
status=0

report() {
  if [ "${GITHUB_ACTIONS:-}" = true ]; then
    printf '::error title=%s%s::%s\n' "${CHECK_LABEL:+$CHECK_LABEL · }" "$1" "$(printf '%s' "$2" | sed 's/%/%25/g')"
  else
    printf 'commit-msg: %s\n  %s\n' "$1" "$2" >&2
  fi
  status=1
}

message=$(sed -e '/^# -\{24\} >8 -\{24\}$/,$d' -e '/^#/d' "$1")
header=$(printf '%s\n' "$message" | sed -n '/[^[:space:]]/{p;q;}')

if [ "${GITHUB_ACTIONS:-}" != true ]; then
  case "$header" in
    'Merge '* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
  esac
fi

if ! printf '%s\n' "$header" | grep -Eq "^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [^[:space:]]"; then
  report "Not a Conventional Commits header" \
    "\"$header\" should read \"type(scope): summary\", where type is one of: $(printf '%s' "$types" | sed 's/|/, /g')."
fi

if [ "${#header}" -gt 72 ]; then
  report "Header too long" "The header is ${#header} characters; keep it to 72 or fewer."
fi

attribution=$(printf '%s\n' "$message" | grep -Ein "co-authored-by:.*($tools)|generated (with|by) .*($tools)|noreply@anthropic\.com" || true)
if [ -n "$attribution" ]; then
  report "AI tool attribution" "Remove these lines: $(printf '%s' "$attribution" | tr '\n' ' ')"
fi

exit "$status"
